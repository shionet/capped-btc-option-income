APP_NAME=crypto-option-income
APP_ENV=dev
LOG_LEVEL=INFO

BINANCE_BASE_URL=https://api.binance.com
BINANCE_OPTIONS_BASE_URL=https://eapi.binance.com
BINANCE_TIMEOUT_SECONDS=12
BINANCE_RECV_WINDOW=5000

# Never commit real credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=

RISK_MAX_SINGLE_TRADE_LOSS_PCT=0.03
RISK_MAX_DAILY_EXPOSURE_PCT=0.15
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_MAX_BID_ASK_SPREAD_RATIO=0.35
RISK_MIN_IV=0.35
RISK_MIN_BID_PRICE=1.0

STRATEGY_SELL_OTM_MIN_PCT=2.0
STRATEGY_SELL_OTM_MAX_PCT=5.0
STRATEGY_WING_WIDTH_MIN_PCT=3.0
STRATEGY_WING_WIDTH_MAX_PCT=8.0
STRATEGY_ALLOWED_DTE=0,1,3

TRADING_LIVE_ENABLED=false
